{
  "name": "MATRIX-MD",
  "description": "MATRIX-MD - The Most Secured And Smartest WhatsApp Bot. A high-performance, multi-device WhatsApp bot with advanced features.",
  "keywords": [
    "MATRIX-MD",
    "whatsapp",
    "bot",
    "whatsapp-bot",
    "multi-device",
    "matrix-md"
  ],
  "repository": "https://github.com/MATRIX-MD-OFFICIAL/SUBZERO-MD",
  "website": "https://github.com/MATRIX-MD-OFFICIAL/SUBZERO-MD",
  "success_url": "/",
  "stack": "heroku-24",
  "env": {
    "SESSION_ID": {
      "description": "Your SESSION_ID - Get it from https://subzero-v2-sessions.onrender.com",
      "required": true,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp Number with country code (e.g 2348115002660)",
      "required": true,
      "value": "2348115002660"
    },
    "BOT_NAME": {
      "description": "Bot Name",
      "required": false,
      "value": "MATRIX-MD"
    },
    "OWNER_NAME": {
      "description": "Owner Name",
      "required": false,
      "value": "MATRIX-MD-OFFICIAL"
    },
    "PREFIX": {
      "description": "Bot Prefix",
      "required": false,
      "value": "."
    },
    "AUTO_STATUS_VIEW": {
      "description": "Auto view status (true/false)",
      "required": false,
      "value": "false"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
